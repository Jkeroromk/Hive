# ─── Database ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL from https://neon.tech or https://railway.app
DATABASE_URL="postgresql://user:password@host:5432/hive?sslmode=require"

# ─── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here"

# Your deployment URL (no trailing slash)
NEXTAUTH_URL="http://localhost:3000"

# ─── Anthropic ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Google OAuth (optional) ──────────────────────────────────────────────────
# Create at https://console.cloud.google.com → APIs & Services → Credentials
# Set to "true" to show Google login button
NEXT_PUBLIC_GOOGLE_AUTH="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ─── File Storage ─────────────────────────────────────────────────────────────
# Default: local filesystem (data/uploads/)
# For production cloud storage, set STORAGE_PROVIDER=r2 and fill in R2 values:
# STORAGE_PROVIDER="local"   # or "r2"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""           # public bucket URL or custom domain
