# ─── Database ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL from https://neon.tech or https://railway.app
DATABASE_URL="postgresql://user:password@host:5432/hive?sslmode=require"

# ─── Clerk Auth ────────────────────────────────────────────────────────────────
# Create a project at https://clerk.com and get your keys from the dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Groq (free) ─────────────────────────────────────────────────────────────
# Get a free key at https://console.groq.com → API Keys
GROQ_API_KEY="gsk_..."

# ─── File Storage ─────────────────────────────────────────────────────────────
# Default: local filesystem (data/uploads/)
# For production cloud storage, set STORAGE_PROVIDER=r2 and fill in R2 values:
# STORAGE_PROVIDER="local"   # or "r2"
# R2_ACCOUNT_ID=""
# R2_ACCESS_KEY_ID=""
# R2_SECRET_ACCESS_KEY=""
# R2_BUCKET_NAME=""
# R2_PUBLIC_URL=""           # public bucket URL or custom domain
