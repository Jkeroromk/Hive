# ─── Database ─────────────────────────────────────────────────────────────────
# Get a free PostgreSQL URL from https://neon.tech or https://railway.app
DATABASE_URL="postgresql://user:password@host:5432/hive?sslmode=require"

# ─── Clerk Auth ────────────────────────────────────────────────────────────────
# Create a project at https://clerk.com and get your keys from the dashboard
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."

# Clerk routing
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/

# ─── Models ───────────────────────────────────────────────────────────────────
# Each agent runs on a model. Set keys only for the providers you use;
# Settings → 偏好设置 → 模型 shows which agents use which provider.

# Claude — https://console.anthropic.com  (default for the team when set)
ANTHROPIC_API_KEY="sk-ant-..."

# Meta Muse Spark — https://dev.meta.ai  (Muse, the cross-model reviewer)
META_API_KEY=""
# META_BASE_URL="https://api.meta.ai/v1"   # override only if Meta changes it

# Optional extra providers
# GROQ_API_KEY="gsk_..."           # https://console.groq.com
# OPENROUTER_API_KEY="sk-or-..."   # https://openrouter.ai — one key, hundreds of models
# OPENAI_API_KEY="sk-..."

# Default model for agents that don't pin one (provider:model).
# If unset: Claude Sonnet when ANTHROPIC_API_KEY is set, else Groq Llama when GROQ_API_KEY is set.
# HIVE_DEFAULT_MODEL="anthropic:claude-sonnet-5-5"

# Swap any single agent's model without touching code: HIVE_MODEL_<AGENT_ID>
# HIVE_MODEL_DEV_TARO="anthropic:claude-opus-5-5"
# HIVE_MODEL_SL_FINN="openrouter:<model-slug-from-openrouter>"

# ─── File Storage ─────────────────────────────────────────────────────────────
# Local dev: files go to data/uploads/.
# On Vercel (read-only disk) they're stored in Postgres automatically, max 4 MB each.
# STORAGE_PROVIDER="db"   # force database storage anywhere
